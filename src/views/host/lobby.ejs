<%- include('../partials/header') %>

<nav class="navbar">
    <div class="logo">QuizArena <span class="badge badge-host">HOST</span></div>
</nav>

<div class="lobby-container animate-fade-in-up">
    <div class="lobby-header">
        <h1>Room Code</h1>
        <div class="room-code-display"><%= room.roomId %></div>
        <p>Ask players to enter this code to join</p>
    </div>

    <div class="lobby-main">
        <div class="players-section">
            <div class="section-title">
                <h2>Joined Players</h2>
                <span class="player-count" id="playerCount">0</span>
            </div>
            <ul class="players-list" id="playersList">
                <li class="empty-state" id="emptyState">Waiting for players to join...</li>
                <!-- Players will be populated here via Socket.io -->
            </ul>
        </div>
        
        <div class="actions-section">
            <div class="quiz-info-card">
                <h3>Quiz: <%= quiz.title %></h3>
                <p><%= quiz.questions.length %> Questions Generated</p>
                <button id="viewQuestionsBtn" class="btn btn-secondary btn-block" style="margin-top: 1rem;">View Questions</button>
            </div>

            <!-- Questions Modal -->
            <div id="questionsModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2>Generated Questions</h2>
                        <span class="close-modal">&times;</span>
                    </div>
                    <div class="modal-body">
                        <% quiz.questions.forEach((q, index) => { %>
                            <div class="question-detail">
                                <p class="q-text"><strong>Q<%= index + 1 %>:</strong> <%= q.questionText %></p>
                                <div class="options-grid">
                                    <% q.options.forEach((opt, i) => { %>
                                        <div class="opt-item <%= i === q.correctAnswer ? 'opt-correct' : '' %>">
                                            <%= opt %>
                                            <% if (i === q.correctAnswer) { %> <span class="check">✓</span> <% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
            
            <button id="startQuizBtn" class="btn btn-primary btn-block btn-large" disabled>Start Quiz</button>
        </div>
    </div>
</div>

<style>
.badge {
    font-size: 0.8rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--primary-color);
    color: white;
    vertical-align: middle;
    margin-left: 0.5rem;
}
.badge-ai {
    background: #a855f7;
    font-size: 0.7rem;
}

.lobby-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
}

.lobby-header {
    text-align: center;
    margin-bottom: 3rem;
}

.room-code-display {
    font-size: 5rem;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 10px;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 1rem 0;
    text-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
}

.lobby-main {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
}

.players-section, .actions-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
}

.player-count {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.3rem 1rem;
    border-radius: var(--radius-full);
    font-weight: bold;
}

.players-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
}

.players-list li:not(.empty-state) {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.8rem;
    border-radius: var(--radius-md);
    text-align: center;
    font-weight: 500;
    animation: fadeInUp 0.3s ease;
}

.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--text-muted);
    padding: 2rem;
}

.quiz-info-card {
    background: rgba(0,0,0,0.2);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}

.question-preview {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.preview-item {
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.btn-large {
    padding: 1.2rem;
    font-size: 1.2rem;
}
.btn-large:disabled {
    background: #333;
    color: #666;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
}

/* Modal Styles */
.modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.8);
    backdrop-filter: blur(5px);
}

.modal-content {
    background-color: var(--bg-card);
    margin: 5% auto;
    padding: 0;
    border: 1px solid var(--border-color);
    width: 80%;
    max-width: 800px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    animation: zoomIn 0.3s ease;
}

.modal-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-body {
    padding: 2rem;
    max-height: 70vh;
    overflow-y: auto;
}

.close-modal {
    color: var(--text-muted);
    font-size: 2rem;
    font-weight: bold;
    cursor: pointer;
    transition: color 0.2s;
}

.close-modal:hover {
    color: white;
}

.question-detail {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.question-detail:last-child {
    border-bottom: none;
}

.q-text {
    font-size: 1.1rem;
    margin-bottom: 1rem;
}

.options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
}

.opt-item {
    background: rgba(255,255,255,0.05);
    padding: 0.8rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.opt-correct {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
}

.check {
    font-weight: bold;
}

@keyframes zoomIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

@media (max-width: 768px) {
    .lobby-main {
        grid-template-columns: 1fr;
    }
    .room-code-display {
        font-size: 3rem;
        letter-spacing: 5px;
    }
    .lobby-container {
        padding: 1rem;
    }
    .players-section, .actions-section {
        padding: 1.5rem;
    }
}

@media (max-width: 768px) {
    .options-grid {
        grid-template-columns: 1fr;
    }
    .modal-content {
        width: 95%;
        margin: 10% auto;
    }
}
</style>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const roomId = '<%= room.roomId %>';
    const playersList = document.getElementById('playersList');
    const playerCount = document.getElementById('playerCount');
    const emptyState = document.getElementById('emptyState');
    const startQuizBtn = document.getElementById('startQuizBtn');

    // Join room as host
    const userId = '<%= user.userId %>';
    const username = '<%= user.username %>';
    socket.emit('host_join', { roomId, userId, username });

    // Handle players joining
    socket.on('player_joined', (players) => {
        updatePlayersList(players);
    });
    
    socket.on('room_state', (data) => {
        if (data.players) updatePlayersList(data.players);
    });
    
    socket.on('update_players', (players) => {
        updatePlayersList(players);
    });

    function updatePlayersList(players) {
        playersList.innerHTML = '';
        playerCount.innerText = players.length;

        if (players.length === 0) {
            playersList.appendChild(emptyState);
            startQuizBtn.disabled = true;
        } else {
            startQuizBtn.disabled = false;
            players.forEach(player => {
                const li = document.createElement('li');
                li.className = player.isAI ? 'ai-player' : '';
                li.innerHTML = player.isAI ? `🤖 ${player.username} <span class="badge badge-ai">BOT</span>` : player.username;
                playersList.appendChild(li);
            });
        }
    }

    startQuizBtn.addEventListener('click', () => {
        socket.emit('start_quiz', { roomId });
    });

    // View Questions Modal Logic
    const viewQuestionsBtn = document.getElementById('viewQuestionsBtn');
    const questionsModal = document.getElementById('questionsModal');
    const closeModal = document.querySelector('.close-modal');

    viewQuestionsBtn.addEventListener('click', () => {
        questionsModal.style.display = 'block';
    });

    closeModal.addEventListener('click', () => {
        questionsModal.style.display = 'none';
    });

    window.addEventListener('click', (event) => {
        if (event.target == questionsModal) {
            questionsModal.style.display = 'none';
        }
    });

    socket.on('quiz_started', () => {
        window.location.href = `/host/game/${roomId}`;
    });
</script>

<%- include('../partials/footer') %>
